{
  "name": "thats-your-cue-template",
  "version": "0.0.1",
  "private": true,
  "homepage": "https://felton.github.io/thats-your-cue/",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:spa": "SPA=true react-router build",
    "dev": "react-router dev",
    "start": "grep -qs '\"isSpaMode\":true' build/client/index.html && echo 'Note: this is an SPA build. It runs here, but deploy build/client to a static host, and preview it with pnpm preview:spa.' >&2; react-router-serve ./build/server/index.js",
    "preview:spa": "sirv build/client --single --port 4173",
    "typecheck": "react-router typegen && tsc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "oxfmt --check && oxlint && react-router typegen && tsc && vitest run",
    "favicon": "sh scripts/favicon.sh",
    "make-it-yours": "node scripts/make-it-yours.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.56.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "shadcn": "^4.21.0",
    "sirv-cli": "^3.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.33.2"
}
