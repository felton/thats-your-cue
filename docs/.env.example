# Copy to .env (gitignored) and uncomment what you need.
# The React Router CLI loads .env for `dev`, `build` and `typegen`.

# Build a static single-page app instead of the Node server build.
# Same as running `pnpm build:spa`. Preview the result with `pnpm preview:spa`.
# SPA=true

# Variables prefixed with VITE_ are available in browser code as
# import.meta.env.VITE_*. They are bundled into the client: no secrets.
# VITE_SITE_URL=https://example.com
